DISCORD_BOT_TOKEN=
# Where MUCA-Server is listening. Defaults to this if unset.
MUCA_SERVER_URL=ws://localhost:8000/
# OPENAI_API_KEY is no longer needed here -- MUCA-Server holds the OpenAI
# client now. Set it in MUCA-Server/.env instead.
#
# Which text/voice channel pairs this bot owns, and each one's participant
# roster, is configured in instances.yaml (see that file), not here -- a
# channel not listed there is simply ignored. DMs always get through
# regardless of instances.yaml and are routed to a separate, private,
# non-persisted memory per user.
