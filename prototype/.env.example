DISCORD_BOT_TOKEN=
# Where MUCA-Server is listening. Defaults to this if unset.
MUCA_SERVER_URL=ws://localhost:8000/
# OPENAI_API_KEY is no longer needed here -- MUCA-Server holds the OpenAI
# client now. Set it in MUCA-Server/.env instead.
#
# Which channels the bot serves isn't configured here: link them from
# Discord with /mulca link (needs Manage Server). Links, and whether the bot
# is stopped, are kept in this SQLite file (default data/mulca.db):
# MULCA_DB_PATH=data/mulca.db
#
# Write what MUCA-Server hears from the voice channel to WAV files here:
# MULCA_VOICE_DEBUG_DIR=voice-debug
