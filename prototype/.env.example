DISCORD_BOT_TOKEN=
# Where MUCA-Server is listening. Defaults to this if unset.
MUCA_SERVER_URL=ws://localhost:8000/
# Comma-separated IDs of this instance's registered GROUP channel(s) (the text
# channel, and eventually the voice channel) -- these share one WM/session.
# Empty = all non-DM channels it can see. DMs always get through regardless of
# this filter and are routed to a separate, private, non-persisted WM per user.
MULCA_CHANNEL_IDS=
# OPENAI_API_KEY is no longer needed here -- MUCA-Server holds the OpenAI
# client now. Set it in MUCA-Server/.env instead.
